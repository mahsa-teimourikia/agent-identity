{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.example/schemas/agent-identity-event-2.0.json",
  "title": "Northstar Agent Identity Evidence Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "event_id",
    "event_type",
    "tenant_id",
    "producer",
    "sequence",
    "occurred_at",
    "trace_id",
    "span_id",
    "actor_id",
    "actor_type",
    "action",
    "resource",
    "outcome"
  ],
  "properties": {
    "schema_name": {"const": "agent.identity.event"},
    "schema_version": {"const": "2.0"},
    "event_id": {"type": "string", "pattern": "^evt:[a-z0-9-]+$"},
    "event_type": {
      "enum": [
        "request.received",
        "agent.invoke",
        "delegation.issued",
        "credential.exchanged",
        "authorization.decision",
        "authorization.enforced",
        "tool.execute",
        "api.access",
        "telemetry.heartbeat"
      ]
    },
    "tenant_id": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "integer", "minimum": 0},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "span_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "parent_span_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{16}$"
    },
    "actor_id": {"type": "string", "minLength": 1},
    "actor_type": {"enum": ["human", "agent", "workload", "service"]},
    "subject_id": {"type": ["string", "null"]},
    "workload_id": {"type": ["string", "null"]},
    "expected_workload_id": {"type": ["string", "null"]},
    "action": {"type": "string", "minLength": 1},
    "resource": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["success", "denied", "failure"]},
    "decision": {"enum": ["permit", "deny", null]},
    "authorization_request_id": {"type": ["string", "null"]},
    "policy_version": {"type": ["string", "null"]},
    "delegation_id": {"type": ["string", "null"]},
    "parent_scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "delegated_scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "credential_fingerprint": {"type": ["string", "null"]},
    "causes_event_id": {"type": ["string", "null"]},
    "attributes": {"type": "object"}
  }
}
