{
  "https://registry.corp.example": {
    "status": "active",
    "credential_types": ["AgentRegistrationCredential"],
    "allowed_subject_claims": ["owner", "agentClass", "releaseDigest", "holderJkt"],
    "max_ttl_seconds": 900,
    "schema": "schemas/agent-registration-vc.schema.json",
    "status_uri": "https://registry.corp.example/status/agents"
  },
  "https://evaluation.corp.example": {
    "status": "active",
    "credential_types": ["AgentEvaluationCredential"],
    "allowed_subject_claims": ["releaseDigest", "configDigest", "suite", "result", "criticalFailures"],
    "max_ttl_seconds": 600,
    "schema": "schemas/agent-evaluation-vc.schema.json",
    "status_uri": "https://evaluation.corp.example/status/results"
  },
  "https://governance.corp.example": {
    "status": "active",
    "credential_types": ["AgentGovernanceCredential"],
    "allowed_subject_claims": ["tenantId", "approvedActions", "approvedResources", "policyVersion"],
    "max_ttl_seconds": 900,
    "schema": "schemas/agent-governance-vc.schema.json",
    "status_uri": "https://governance.corp.example/status/approvals"
  },
  "https://attacker.example": {
    "status": "blocked",
    "credential_types": [],
    "allowed_subject_claims": [],
    "max_ttl_seconds": 0,
    "schema": "",
    "status_uri": "https://attacker.example/status"
  }
}
