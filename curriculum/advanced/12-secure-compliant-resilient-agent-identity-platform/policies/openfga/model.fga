model
  schema 1.1

type user

type tenant
  relations
    define member: [user]

type agent
  relations
    define operator: [user]
    define can_delegate_to: [agent]

type task
  relations
    define initiator: [user]
    define assigned_agent: [agent]
    define can_execute: assigned_agent

type claim
  relations
    define tenant: [tenant]
    define assignee: [user]
    define reader: [user, agent]
    define editor: [user, agent]
    define can_read: assignee or reader or editor
    define can_update: assignee or editor

type tool
  relations
    define invoker: [agent]
    define can_invoke: invoker
