model
  schema 1.1

type user

type tenant
  relations
    define member: [user, agent]

type agent
  relations
    define operator: [user]
    define delegate: [agent]

type claim
  relations
    define tenant: [tenant]
    define reader: [user, agent]
    # Direct assignment is necessary but not sufficient: the reader must also
    # belong to the tenant that owns the claim.
    define can_read: reader and member from tenant
