model
  schema 1.1

type user

type tenant
  relations
    define member: [user, agent]

type agent
  relations
    define operator: [user]
    define tenant: [tenant]

type task
  relations
    define assignee: [agent]
    define tenant: [tenant]

type claim
  relations
    define tenant: [tenant]
    define task: [task]
    define reader: [user, agent]
    define editor: [user, agent]
    define tenant_member: member from tenant
    define can_read: (reader or editor) and tenant_member
    define can_update: editor and tenant_member

type tool
  relations
    define invoker: [agent]
    define tenant: [tenant]
    define tenant_member: member from tenant
    define can_invoke: invoker and tenant_member
