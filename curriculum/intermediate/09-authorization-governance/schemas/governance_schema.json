{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.example/schemas/authorization-governance-v1.json",
  "title": "Authorization governance inventory snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["inventory_version", "policy_version", "captured_at", "agents", "entitlements", "delegations", "exceptions"],
  "properties": {
    "inventory_version": {"type": "integer", "minimum": 1},
    "policy_version": {"type": "string", "pattern": "^policy:[A-Za-z0-9._-]+$"},
    "captured_at": {"$ref": "#/$defs/timestamp"},
    "agents": {"type": "array", "items": {"$ref": "#/$defs/agent"}},
    "entitlements": {"type": "array", "items": {"$ref": "#/$defs/entitlement"}},
    "delegations": {"type": "array", "items": {"$ref": "#/$defs/delegation"}},
    "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}}
  },
  "$defs": {
    "timestamp": {"type": "integer", "minimum": 0},
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "resource"],
      "properties": {
        "action": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"},
        "resource": {"type": "string", "minLength": 3}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "tenant_id", "owner_id", "status", "risk_tier", "last_seen", "workload_id"],
      "properties": {
        "agent_id": {"type": "string", "pattern": "^agent:"},
        "tenant_id": {"type": "string", "pattern": "^tenant:"},
        "owner_id": {"type": ["string", "null"]},
        "status": {"enum": ["active", "disabled", "retired"]},
        "risk_tier": {"enum": ["R1", "R2", "R3", "R4"]},
        "last_seen": {"$ref": "#/$defs/timestamp"},
        "workload_id": {"type": "string", "pattern": "^spiffe://"}
      }
    },
    "entitlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entitlement_id", "principal_id", "tenant_id", "action", "resource", "source", "owner_id", "justification", "risk", "created_at", "expires_at", "last_used", "version"],
      "properties": {
        "entitlement_id": {"type": "string", "pattern": "^ent:"},
        "principal_id": {"type": "string", "minLength": 3},
        "tenant_id": {"type": "string", "pattern": "^tenant:"},
        "action": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"},
        "resource": {"type": "string", "minLength": 3},
        "source": {"enum": ["policy", "role", "delegation", "exception", "task"]},
        "owner_id": {"type": "string", "minLength": 1},
        "justification": {"type": "string", "minLength": 1},
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "last_used": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegation_id", "delegator", "delegatee", "tenant_id", "permissions", "parent_id", "depth", "max_depth", "redelegable", "issued_at", "expires_at", "task_id", "active"],
      "properties": {
        "delegation_id": {"type": "string", "pattern": "^del:"},
        "delegator": {"type": "string", "minLength": 3},
        "delegatee": {"type": "string", "pattern": "^agent:"},
        "tenant_id": {"type": "string", "pattern": "^tenant:"},
        "permissions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/permission"}},
        "parent_id": {"type": ["string", "null"]},
        "depth": {"type": "integer", "minimum": 0},
        "max_depth": {"type": "integer", "minimum": 0},
        "redelegable": {"type": "boolean"},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "task_id": {"type": "string", "pattern": "^task:"},
        "active": {"type": "boolean"}
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exception_id", "principal_id", "tenant_id", "permission", "reason", "approver_ids", "controls", "ticket_id", "issued_at", "expires_at", "policy_version", "revoked"],
      "properties": {
        "exception_id": {"type": "string", "pattern": "^exc:"},
        "principal_id": {"type": "string", "minLength": 3},
        "tenant_id": {"type": "string", "pattern": "^tenant:"},
        "permission": {"$ref": "#/$defs/permission"},
        "reason": {"type": "string", "minLength": 1},
        "approver_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "ticket_id": {"type": "string", "minLength": 1},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "policy_version": {"type": "string", "pattern": "^policy:"},
        "revoked": {"type": "boolean"}
      }
    }
  }
}
