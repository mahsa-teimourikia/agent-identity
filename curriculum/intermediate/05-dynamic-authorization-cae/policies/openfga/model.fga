model
  schema 1.1

type agent

type task
  relations
    define assignee: [agent]
    define delegated_agent: [agent]
    define active_participant: assignee and delegated_agent

type claim
  relations
    define assigned_task: [task]
    define reader: active_participant from assigned_task
    define updater: active_participant from assigned_task
    define can_read: reader
    define can_update: updater

# OpenFGA answers the relationship question only. The PEP must also require
# current subject, tenant, workload, task lifetime, risk, policy, resource,
# stream freshness, and exact approval facts from the contextual policy plane.
