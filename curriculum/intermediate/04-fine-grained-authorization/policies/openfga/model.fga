model
  schema 1.1

type user

type agent

type task
  relations
    define requester: [user]
    define assignee: [agent]
    # Written only after verified user-to-agent delegation is resolved.
    define delegated_agent: [agent]
    define active_agent: assignee and delegated_agent

type claim
  relations
    define owner: [user]
    define assigned_task: [task]
    define viewer: [user]
    define can_read: viewer or active_agent from assigned_task
    define can_update: active_agent from assigned_task
    define can_pay: active_agent from assigned_task
